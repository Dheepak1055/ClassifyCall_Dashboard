# Example environment variables for BDA Video Call Dashboard backend
# ------------------------------------------------------------
# CLASSIFY credentials – keep these secret!
# Replace the placeholder values with your actual secrets in a .env file (not committed to repo).
CLASSIFY_API_KEY=your_classify_api_key_here
CLASSIFY_AUTH_TOKEN=your_classify_auth_token_here
CLASSIFY_ORG_ID=your_classify_org_id_here

# Lead Call API key – keep secret!
LEAD_CALL_API_KEY=your_lead_call_api_key_here

# JWT secret for authentication (use a strong random value)
JWT_SECRET=your_jwt_secret_here

# Database connection URL (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/database_name

# Application settings
PORT=4000
